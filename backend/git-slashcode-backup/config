[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/slashcode-projects/support-request-backend.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "feature/ticket-rest-apis"]
	remote = origin
	merge = refs/heads/feature/ticket-rest-apis
	vscode-merge-base = origin/feature/ticket-rest-apis
[branch "spring-security/security-config"]
	remote = origin
	merge = refs/heads/spring-security/security-config
	vscode-merge-base = origin/spring-security/security-config
